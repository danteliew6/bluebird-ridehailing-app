{
  "datasets": [
    {
      "name": "ds_trips",
      "displayName": "Trips",
      "queryLines": [
        "SELECT to_date(t.request_ts) AS trip_date, hour(t.request_ts) AS trip_hour, ",
        "       t.city AS city, t.fleet_brand AS fleet_brand, t.service_type AS service_type, ",
        "       t.payment_method AS payment_method, t.status AS status, ",
        "       t.fare_idr AS fare_idr, t.surge_multiplier AS surge_multiplier, ",
        "       t.distance_km AS distance_km, t.wait_time_min AS wait_time_min, t.rating AS rating, ",
        "       z.area_name AS pickup_area, z.zone_type AS pickup_zone_type ",
        "FROM fact_trip t ",
        "LEFT JOIN dim_zone z ON t.pickup_zone_id = z.zone_id"
      ],
      "columns": [
        {"displayName": "Total Trips", "description": "Count of trip requests", "expression": "COUNT(1)"},
        {"displayName": "Completed Trips", "description": "Completed trips", "expression": "SUM(CASE WHEN `status`='completed' THEN 1 ELSE 0 END)"},
        {"displayName": "Revenue Bn IDR", "description": "Total fare revenue in billions of IDR", "expression": "SUM(`fare_idr`)/1000000000.0"},
        {"displayName": "Cancellation Rate", "description": "Cancelled / all trips", "expression": "SUM(CASE WHEN `status`='cancelled' THEN 1 ELSE 0 END)*1.0/COUNT(1)"},
        {"displayName": "No Driver Rate", "description": "No-driver / all trips", "expression": "SUM(CASE WHEN `status`='no_driver' THEN 1 ELSE 0 END)*1.0/COUNT(1)"},
        {"displayName": "Avg Surge", "description": "Average surge multiplier", "expression": "AVG(`surge_multiplier`)"},
        {"displayName": "Avg Wait Min", "description": "Average wait time (minutes)", "expression": "AVG(`wait_time_min`)"},
        {"displayName": "Avg Rating", "description": "Average completed-trip rating", "expression": "AVG(`rating`)"}
      ]
    },
    {
      "name": "ds_fleet",
      "displayName": "Fleet health",
      "queryLines": [
        "SELECT to_date(reading_date) AS reading_date, fleet_brand, vehicle_id, ",
        "       anomaly_score, needs_service_flag, brake_wear_pct, battery_v ",
        "FROM fact_vehicle_health"
      ],
      "columns": [
        {"displayName": "Avg Anomaly", "description": "Average anomaly score (0-1)", "expression": "AVG(`anomaly_score`)"},
        {"displayName": "Service Needed Rate", "description": "Share of readings needing service", "expression": "AVG(`needs_service_flag`)"},
        {"displayName": "Avg Brake Wear", "description": "Average brake wear percent", "expression": "AVG(`brake_wear_pct`)"},
        {"displayName": "Readings", "description": "Telematics readings", "expression": "COUNT(1)"}
      ]
    }
  ],
