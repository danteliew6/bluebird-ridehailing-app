{
  "name": "bluebird-realtime-ingest",
  "description": "Near-real-time synthetic ingestion + DQ pipeline + serving-gold rebuild + Lakebase reload.",
  "git_source": {
    "git_url": "https://github.com/danteliew6/bluebird-ridehailing-app",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "gen_stream_batch",
      "spark_python_task": {
        "python_file": "jobs/gen_stream_batch.py",
        "source": "GIT",
        "parameters": ["400"]
      },
      "environment_key": "default"
    },
    {
      "task_key": "run_dq_pipeline",
      "depends_on": [{"task_key": "gen_stream_batch"}],
      "pipeline_task": {"pipeline_id": "83464893-0567-4198-b580-633f026db12c"}
    },
    {
      "task_key": "rebuild_serving_gold",
      "depends_on": [{"task_key": "run_dq_pipeline"}],
      "spark_python_task": {
        "python_file": "jobs/rebuild_serving_gold.py",
        "source": "GIT"
      },
      "environment_key": "default"
    },
    {
      "task_key": "reload_lakebase",
      "depends_on": [{"task_key": "rebuild_serving_gold"}],
      "spark_python_task": {
        "python_file": "jobs/reload_lakebase.py",
        "source": "GIT"
      },
      "environment_key": "reload"
    }
  ],
  "environments": [
    {"environment_key": "default", "spec": {"client": "3"}},
    {"environment_key": "reload", "spec": {"client": "3", "dependencies": ["pg8000", "databricks-sdk"]}}
  ],
  "schedule": {
    "quartz_cron_expression": "0 */10 * * * ?",
    "timezone_id": "Asia/Jakarta",
    "pause_status": "PAUSED"
  },
  "queue": {"enabled": true},
  "max_concurrent_runs": 1
}
